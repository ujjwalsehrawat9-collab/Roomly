<% layout("/layouts/boilerPlate") %>

<div class="row mt-4">
  <div class="col-10 offset-1 col-md-6 offset-md-3">
    <div class="card error-card border-danger">
      <div class="card-body text-center">
        <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 2.5rem;"></i>
        <h4 class="mt-3">Something went wrong</h4>
        <p class="text-muted mb-0"><%= message %></p>
      </div>
    </div>
    <div class="text-center mt-3">
      <a href="/listings" class="btn btn-dark">Back to Listings</a>
    </div>
  </div>
</div>