<% layout("/layouts/boilerPlate") %>

<div id="filter-wrapper">
  <button class="scroll-btn left-btn"><i class="fa-solid fa-less-than"></i></button>
  <div id="filters-container">
    <div id="filters">
      <div class="filter">
        <a href="/listings/filter/Trending">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending</p>
        </a>
      </div>
      <% categories.forEach(cat => { %>
      <div class="filter">
        <a href="/listings/filter/<%= cat.value %>">
          <div><i class="<%= cat.icon %>"></i></div>
          <p><%= cat.label %></p>
        </a>
      </div>
      <% }) %>
    </div>
  </div>
  <button class="scroll-btn right-btn"><i class="fa-solid fa-greater-than"></i></button>
  <div class="tax-toggle">
    <div class="toggle-container">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
        <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
      </div>
    </div>
  </div>
</div>

<div class="row row-cols-1 row-cols-sm-1 row-cols-md-2 row-cols-lg-4 row-cols-adjust mt-2">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img
          src="<%= listing.image && listing.image.url ? listing.image.url : '/images/placeholder.svg' %>"
          onerror="this.onerror=null;this.src='/images/placeholder.svg'"
          class="card-img-top listing-index-img"
          alt="listing_image"
        />
        <div class="card-img-overlay"></div>
        <div class="listing-card-body mt-2">
          <p class="listing-card-text">
            <b><%= listing.title %></b> <br />
            &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "NA" %> / night
            <i class="tax-info">&nbsp; &nbsp; + 18% GST</i>
          </p>
          <% if (listing.category && listing.category.length) { %>
          <% [].concat(listing.category).forEach(cat => { %>
          <span class="category-badge">
            <i class="fa-solid fa-tag"></i> <%= cat.replace(/-/g, " ") %>
          </span>
          <% }) %>
          <% } %>
        </div>
      </div>
    </a>
  <% } %>
</div>